# Environment Variables for Keeper Sports Backend
PORT=6000
NODE_ENV=production

# Supabase Credentials (Required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key
SUPABASE_REVIEW_BUCKET=review-images

# JWT Security
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-chars
JWT_EXPIRES_IN=7d

# Frontend URL (For CORS & Cookie credentials)
# In production, set this to your Vercel frontend URL: https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:5173
