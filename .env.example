# Environment Variables for Keeper Sports Backend
PORT=6000
NODE_ENV=production

# Supabase Credentials (Required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key
SUPABASE_REVIEW_BUCKET=review-images

# JWT Security
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-chars
JWT_EXPIRES_IN=7d

# Frontend URL (For CORS & Cookie credentials)
FRONTEND_URL=https://keepersportlb.com

# Google OAuth Client ID
GOOGLE_CLIENT_ID=1062540118427-33h5nnpasi9sq5lqoiij6umjmjscenu1.apps.googleusercontent.com

# Resend Transactional Email
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=Keeper Sports <no-reply@keepersportlb.com>
